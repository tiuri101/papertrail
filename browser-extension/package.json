{
  "name": "papertrail-browser-extension",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Chrome Manifest V3 extension that retrieves publisher PDFs for Papertrail using the user's own browser network access and sign-in state.",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/chrome": "0.0.280",
    "@types/node": "24.2.1",
    "eslint": "9.33.0",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.1",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  }
}
