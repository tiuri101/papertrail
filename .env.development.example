# Local development configuration.
# Copy this file to .env.development. Do not commit the copied file.

# PostgreSQL container used by docker-compose.dev.yml
POSTGRES_DB=papertrail
POSTGRES_USER=papertrail
POSTGRES_PASSWORD=papertrail-dev
POSTGRES_PORT=5432

# FastAPI application running directly on the host
PAPERTRAIL_ENV=development
PAPERTRAIL_DATABASE_URL=postgresql+psycopg://papertrail:papertrail-dev@127.0.0.1:5432/papertrail
PAPERTRAIL_IMPORT_DIR=./data/imports
PAPERTRAIL_EXPORT_DIR=./data/exports
PAPERTRAIL_PDF_STORAGE_PATH=./data/pdfs
PAPERTRAIL_MAX_PDF_SIZE_MB=50
PAPERTRAIL_SESSION_COOKIE_SECURE=false
PAPERTRAIL_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
PAPERTRAIL_CORS_ORIGINS=http://localhost:5173
PAPERTRAIL_WORKER_THREADS=4
PAPERTRAIL_JOB_POLL_INTERVAL_SECONDS=1
PAPERTRAIL_JOB_LEASE_SECONDS=300
PAPERTRAIL_BROWSER_AGENT_PAIRING_TTL_MINUTES=10
PAPERTRAIL_BROWSER_RETRIEVAL_LEASE_SECONDS=300
PAPERTRAIL_PASSWORD_RESET_TTL_MINUTES=60
PAPERTRAIL_PASSWORD_RESET_MAX_ATTEMPTS=5

# Optional SMTP email notifications. Leave disabled for ordinary development.
PAPERTRAIL_EMAIL_ENABLED=false
PAPERTRAIL_PUBLIC_BASE_URL=http://localhost:5173
# PAPERTRAIL_SMTP_HOST=localhost
PAPERTRAIL_SMTP_PORT=1025
# PAPERTRAIL_SMTP_FROM_ADDRESS=Papertrail <papertrail@localhost>
PAPERTRAIL_SMTP_STARTTLS=false
PAPERTRAIL_SMTP_USE_SSL=false

# Optional external Ollama integration. Leave disabled for normal development/tests.
PAPERTRAIL_LLM_ENABLED=false
# PAPERTRAIL_OLLAMA_BASE_URL=http://ollama.internal:11434
# PAPERTRAIL_OLLAMA_MODEL=qwen3:8b
PAPERTRAIL_OLLAMA_REQUEST_TIMEOUT_SECONDS=300
PAPERTRAIL_LLM_MAX_CONCURRENT_JOBS=1
PAPERTRAIL_LLM_CONTEXT_LENGTH=32768
PAPERTRAIL_LLM_MAX_EVIDENCE_ITEMS=3
PAPERTRAIL_LLM_MAX_EVIDENCE_QUOTE_CHARS=500
