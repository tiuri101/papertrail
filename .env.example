# Production/self-hosted configuration. For local development, copy .env.development.example instead.
# Copy to .env before starting Papertrail.
POSTGRES_DB=papertrail
POSTGRES_USER=papertrail
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Least-privilege database identity the API and workers actually connect as
# (DML only -- no schema/DDL rights). 
# See docs/operations/security.md#database-privilege-separation.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PAPERTRAIL_RUNTIME_DATABASE_ROLE=papertrail_app
PAPERTRAIL_RUNTIME_DATABASE_PASSWORD=replace-with-a-long-random-password

# Docker image tag to deploy (required, no default).
PAPERTRAIL_IMAGE_TAG=latest

# Host ports for the frontend and API containers. Point your reverse proxy at these.
# The binds stay on loopback for a same-host proxy; widen them only for a proxy on
# another host, and then list that proxy's address in PAPERTRAIL_TRUSTED_PROXY_IPS.
PAPERTRAIL_FRONTEND_PORT=80
PAPERTRAIL_API_PORT=8000
PAPERTRAIL_SESSION_COOKIE_SECURE=true
PAPERTRAIL_ALLOWED_HOSTS=papertrail.example.org,127.0.0.1
PAPERTRAIL_CORS_ORIGINS=https://papertrail.example.org
PAPERTRAIL_FRONTEND_BIND=127.0.0.1
PAPERTRAIL_API_BIND=127.0.0.1
PAPERTRAIL_TRUSTED_PROXY_IPS=127.0.0.1

# Startup refuses to run with an insecure cookie/CORS/host/URL/default-password
# setting while PAPERTRAIL_ENV=production (the default under Compose). Leave
# this unset/false; only set it true for a deliberately insecure internal
# throwaway stack, never on an installation reachable from the internet.
# PAPERTRAIL_ALLOW_INSECURE_PRODUCTION=false
# Interactive API docs/OpenAPI schema are off by default in production.
# Uncomment to force them on (e.g. temporarily, for a client-generation task).
# PAPERTRAIL_API_DOCS_ENABLED=true

PAPERTRAIL_WORKER_THREADS=4
PAPERTRAIL_JOB_POLL_INTERVAL_SECONDS=1
PAPERTRAIL_JOB_LEASE_SECONDS=300

# Browser Helper (Chrome extension) PDF retrieval: how long a one-time pairing
# secret stays valid, and how long an extension may hold a claimed retrieval
# job before it is considered abandoned and reclaimable.
PAPERTRAIL_BROWSER_AGENT_PAIRING_TTL_MINUTES=10
PAPERTRAIL_BROWSER_RETRIEVAL_LEASE_SECONDS=300

# Password reset link lifetime and per-account attempt limit.
PAPERTRAIL_PASSWORD_RESET_TTL_MINUTES=60
PAPERTRAIL_PASSWORD_RESET_MAX_ATTEMPTS=5

# Encrypts the password-reset link while it sits in the notification queue, so
# a database dump alone never yields a usable reset token. Required for
# self-service password recovery; must be the same value for the API and the
# worker, and must never be stored in the database or logged.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PAPERTRAIL_NOTIFICATION_ENCRYPTION_KEY=replace-with-a-generated-random-value

# Optional email notifications. SMTP is used only by the background worker.
PAPERTRAIL_EMAIL_ENABLED=false
PAPERTRAIL_PUBLIC_BASE_URL=https://papertrail.example.org
PAPERTRAIL_SMTP_HOST=smtp.example.org
PAPERTRAIL_SMTP_PORT=587
PAPERTRAIL_SMTP_USERNAME=noreply@example.org
PAPERTRAIL_SMTP_PASSWORD=replace-with-an-app-password
PAPERTRAIL_SMTP_FROM_ADDRESS=Papertrail <noreply@example.org>
PAPERTRAIL_SMTP_STARTTLS=true
PAPERTRAIL_SMTP_USE_SSL=false
PAPERTRAIL_SMTP_TIMEOUT_SECONDS=30

# Full-text PDFs are stored in a dedicated Docker volume at /pdf-data.
PAPERTRAIL_MAX_PDF_SIZE_MB=50

# Optional LLM-assisted extraction. Ollama runs separately and is never managed by Compose.
PAPERTRAIL_LLM_ENABLED=false
# Required when LLM support is enabled; use only the server base URL (no /api/chat suffix).
PAPERTRAIL_OLLAMA_BASE_URL=http://ollama.internal:11434
PAPERTRAIL_OLLAMA_MODEL=qwen3:8b
PAPERTRAIL_OLLAMA_REQUEST_TIMEOUT_SECONDS=600
PAPERTRAIL_LLM_MAX_CONCURRENT_JOBS=1
PAPERTRAIL_LLM_CONTEXT_LENGTH=32768
PAPERTRAIL_LLM_MAX_EVIDENCE_ITEMS=3
PAPERTRAIL_LLM_MAX_EVIDENCE_QUOTE_CHARS=500
PAPERTRAIL_LLM_MAX_OUTPUT_TOKENS=4096
# Optional bearer token used when Ollama is protected by a reverse proxy.
# PAPERTRAIL_OLLAMA_API_KEY=

# Used by the migration container to bootstrap the first administrator.
# Keep this set for every `docker compose up` invocation.
PAPERTRAIL_ADMIN_USERNAME=admin
PAPERTRAIL_ADMIN_DISPLAY_NAME=Papertrail Administrator
PAPERTRAIL_ADMIN_PASSWORD=replace-with-at-least-12-characters
